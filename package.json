{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "clean": "php artisan config:clear && php artisan view:clear",
    "serve": "php artisan serve --host=127.0.0.1 --no-reload",
    "start": "npm run clean && concurrently -k -p \"[{name}]\" -n \"VITE,LARAVEL\" -c \"bgMagenta.bold,bgBlue.bold\" \"npm run dev\" \"npm run serve\""
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^10.0.3",
    "laravel-vite-plugin": "^3.1",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  },
  "dependencies": {
    "@inertiajs/vue3": "^3.9.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "exceljs": "^4.4.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  }
}